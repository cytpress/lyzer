{
  "name": "@lyzer/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/cli.ts db:migrate",
    "job:fetch": "tsx src/cli.ts job:fetch",
    "job:analyze": "tsx src/cli.ts job:analyze",
    "job:build": "tsx src/cli.ts job:build",
    "job:deploy": "tsx src/cli.ts job:deploy",
    "job:daily": "tsx src/cli.ts job:daily"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "@hono/node-server": "^1.19.6",
    "dotenv": "^17.2.3",
    "hono": "^4.10.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.50.0"
  }
}
