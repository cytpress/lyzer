---
import BookmarkButton from "./BookmarkButton.astro";
import { getCommitteeStyle } from "../lib/committee";
import type { HomepageAgenda } from "../types";

interface Props {
  agenda: HomepageAgenda;
}

const { agenda } = Astro.props;
const committee = agenda.committee ?? "委員會";
const committeeStyle = getCommitteeStyle(committee);
const meetingDate = agenda.meetingDate ?? agenda.meetingDates[0] ?? "日期未明";
---

<li class="page-shell-narrow" data-agenda-card data-agenda-id={agenda.agendaId}>
  <article class="agenda-card relative flex flex-col justify-center px-4 py-5 md:px-8 md:py-7">
    <div class="mb-3 flex items-start justify-between gap-4">
      <a class="min-w-0 after:absolute after:inset-0 after:content-['']" href={`/gazettes/${agenda.agendaId}`}>
        <h2 class="text-lg leading-snug font-medium text-neutral-900 md:text-xl">
          {agenda.summaryTitle}
        </h2>
      </a>
      <div class="relative z-10"><BookmarkButton agendaId={agenda.agendaId} /></div>
    </div>

    <div class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-neutral-600 md:text-sm">
      <span class="committee-tag" data-tone={committeeStyle.tone}>
        <span class="md:hidden">{committeeStyle.shortName}</span><span class="hidden md:inline">{committee}</span>
      </span>
      <span>會議日期：{meetingDate}</span>
      <span class="hidden text-neutral-300 md:inline">／</span>
      <span class="hidden truncate md:inline">{agenda.gazetteId}</span>
    </div>

    <p class="line-clamp-2 text-sm leading-7 text-neutral-600 md:line-clamp-3">
      {agenda.overallSummary || agenda.subject || "此議程尚無摘要。"}
    </p>
  </article>
</li>
