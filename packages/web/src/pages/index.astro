---
// 產生首頁最新摘要、委員會篩選與搜尋介面
import AgendaCard from "@/components/AgendaCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCommittees, getHomepageAgendas } from "@/lib/api";
import { normalizeCommitteeList } from "@/lib/committee";

const [agendas, rawCommittees] = await Promise.all([getHomepageAgendas(), getCommittees()]);
const committees = normalizeCommitteeList(rawCommittees);
const firstPage = agendas.slice(0, 10);
const serializedFirstPage = JSON.stringify(firstPage).replaceAll("<", "\\u003c");
---

<BaseLayout title="LYZER 立法院公報摘要">
  <section data-search-page data-total-count={agendas.length}>
    <script is:inline id="lyzer-agendas-data" type="application/json" set:html={serializedFirstPage} />

    <div class="page-shell mb-6 flex flex-col gap-4">
      <div id="search" class="md:hidden">
        <label class="relative block">
          <span class="sr-only">搜尋公報摘要</span>
          <input
            class="h-11 w-full rounded-2xl border-2 border-neutral-300 bg-white px-4 text-sm outline-none placeholder:text-neutral-400 focus:border-neutral-500"
            type="search"
            data-search-input
            placeholder="搜尋議題、法案、委員或官員"
          />
        </label>
      </div>

      <div
        class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 md:mx-0 md:flex-wrap md:overflow-visible md:px-0"
        data-committee-filters
        aria-label="依委員會篩選"
      >
        <button class="filter-chip" type="button" data-committee-button data-committee="" data-active="true">
          全部
        </button>
        {
          committees.map((name) => (
            <button class="filter-chip" type="button" data-committee-button data-committee={name} data-active="false">
              {name}
            </button>
          ))
        }
      </div>

      <div class="flex min-h-10 items-center justify-between gap-3 text-sm text-neutral-500">
        <span data-result-count>{agendas.length} 筆摘要</span>
        <div class="flex items-center gap-2">
          <span data-search-status role="status" aria-live="polite"></span>
          <label class="hidden items-center gap-2" data-sort-control>
            <span>排序</span>
            <select
              class="rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm outline-none focus:border-neutral-500"
              data-sort-select
            >
              <option value="date-desc">日期新到舊</option>
              <option value="date-asc">日期舊到新</option>
              <option value="relevance">相關性</option>
            </select>
          </label>
        </div>
      </div>
    </div>

    <ul class="space-y-4" data-agenda-list>
      {firstPage.map((agenda) => <AgendaCard agenda={agenda} />)}
    </ul>

    <div
      class="page-shell mt-10 hidden rounded-3xl border border-dashed border-neutral-300 bg-white p-10 text-center text-neutral-500"
      data-empty-state
    >
      沒有符合條件的議事摘要。
    </div>

    <nav class="page-shell mt-8 flex items-center justify-center gap-2" data-pagination aria-label="分頁"></nav>
  </section>
</BaseLayout>
