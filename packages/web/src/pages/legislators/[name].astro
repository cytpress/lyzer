---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLegislatorStats } from "../../lib/api";

export async function getStaticPaths() {
  // 1. 在編譯期自 Hono 後端 SSG 統一端點載入已聚合的立委資料 (僅需 1 次 API 呼叫，極致高效！)
  const rawLegislators = await getLegislatorStats();

  return rawLegislators.map((leg) => {
    // 依日期排序時間軸
    leg.timeline.sort((a, b) => b.meetingDate.localeCompare(a.meetingDate));
    return {
      params: { name: leg.name },
      props: {
        leg: {
          name: leg.fullName, // Frontend uses leg.name as "黃國昌 委員"
          speechCount: leg.speechCount,
          timeline: leg.timeline,
        },
      },
    };
  });
}

const { leg } = Astro.props as {
  leg: {
    name: string;
    speechCount: number;
    timeline: Array<{
      agendaId: string;
      title: string;
      meetingDate: string;
      committee: string;
      viewpoints: string[];
    }>;
  };
};
---

<BaseLayout title={`${leg.name} 發言時間軸 | lyzer`}>
  <section class="mx-auto mb-8 w-11/12 md:mb-10 md:w-4/5">
    <div class="mb-6">
      <a class="mb-4 inline-flex text-sm text-neutral-500 transition hover:text-neutral-900" href="/legislators"
        >← 回立委名冊</a
      >

      <div class="mt-4 flex flex-col justify-between gap-4 md:flex-row md:items-center">
        <div>
          <h1 class="flex items-center gap-4 text-4xl font-bold tracking-tight text-neutral-950 md:text-6xl">
            {leg.name}
            <span class="rounded-full bg-amber-100 px-4 py-1.5 text-sm font-semibold text-amber-800">
              累計發言 {leg.speechCount} 次
            </span>
          </h1>
          <p class="mt-2 text-base text-neutral-600 md:text-lg">
            本頁收錄 {leg.name} 在立法院各常設及特別委員會中所有被 AI 結構化分析後的發言紀錄。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 時間軸區域 -->
  <div class="mx-auto w-11/12 md:w-4/5">
    <h2 class="mb-8 flex items-center gap-2 text-xl font-semibold text-neutral-900">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-amber-500"></span>
      參與會議與問詢時間軸
    </h2>

    {
      leg.timeline.length > 0 ? (
        <div class="relative space-y-12 border-l-2 border-neutral-200 pl-6 md:pl-8">
          {leg.timeline.map((event) => (
            <div class="relative">
              {/* 時間軸的圓點 */}
              <span class="absolute -left-[31px] mt-1.5 flex h-4 w-4 items-center justify-center rounded-full border-4 border-amber-500 bg-white md:-left-[39px]" />

              <div class="flex flex-col gap-4 md:flex-row md:items-start">
                {/* 時間與委員會標籤 */}
                <div class="min-w-[12rem]">
                  <time class="block text-lg font-bold text-neutral-900">{event.meetingDate}</time>
                  <span class="mt-2 inline-block rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-700">
                    {event.committee}
                  </span>
                </div>

                {/* 會議內容與發言摘要卡片 */}
                <div class="flex-1 rounded-3xl border-2 border-neutral-200 bg-white p-6 transition duration-300 hover:border-neutral-400 hover:shadow-md md:p-8">
                  <a
                    href={`/gazettes/${event.agendaId}`}
                    class="block text-xl leading-snug font-semibold text-neutral-950 transition-colors hover:text-amber-600"
                  >
                    {event.title}
                  </a>

                  {event.viewpoints.length > 0 ? (
                    <div class="mt-5">
                      <h4 class="mb-2 text-sm font-semibold text-neutral-400">本次會議發言重點</h4>
                      <ul class="list-disc space-y-2 pl-5 leading-8 text-neutral-700">
                        {event.viewpoints.map((point) => (
                          <li>{point}</li>
                        ))}
                      </ul>
                    </div>
                  ) : (
                    <p class="mt-4 text-sm text-neutral-500 italic">本次會議主要列席討論，無單獨被結構化記錄的論點。</p>
                  )}

                  <div class="mt-6 flex items-center justify-end border-t border-neutral-100 pt-4">
                    <a
                      href={`/gazettes/${event.agendaId}`}
                      class="inline-flex items-center gap-1 text-sm font-semibold text-amber-600 transition-colors hover:text-amber-800"
                    >
                      查看完整公報摘要與問答大綱 ➔
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="py-8 text-neutral-500">暫無時間軸發言紀錄。</p>
      )
    }
  </div>
</BaseLayout>
