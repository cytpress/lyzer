---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLegislatorStats } from "../../lib/api";

// 1. 在編譯期直接自 Hono 後端 SSG 統一端點載入已聚合的立委資料 (僅需 1 次 API 呼叫，極致高效！)
const rawLegislators = await getLegislatorStats();

// 統一為 LegislatorStat 格式 (name 重組以符合前端 name/fullName 顯示)
interface LegislatorStat {
  name: string;
  fullName: string;
  speechCount: number;
  lastSpeechDate: string;
  lastAgendaId: string;
  lastAgendaTitle: string;
}

// 轉化為陣列並排序
const legislators: LegislatorStat[] = rawLegislators
  .map((leg) => ({
    name: leg.fullName, // Frontend uses leg.name as "黃國昌 委員"
    fullName: leg.fullName,
    speechCount: leg.speechCount,
    lastSpeechDate: leg.lastSpeechDate,
    lastAgendaId: leg.lastAgendaId,
    lastAgendaTitle: leg.lastAgendaTitle,
  }))
  .sort((a, b) => b.speechCount - a.speechCount);

// 按分組歸類
const groups: Record<string, LegislatorStat[]> = {
  高頻率發言委員: legislators.slice(0, 8),
  所有活躍委員: legislators,
};
---

<BaseLayout title="立委發言目錄 | lyzer">
  <section class="mx-auto mb-8 w-11/12 md:mb-10 md:w-4/5">
    <div class="mb-6">
      <a class="mb-4 inline-flex text-sm text-neutral-500 transition hover:text-neutral-900" href="/">← 回首頁</a>
      <h1 class="text-3xl leading-tight font-semibold tracking-normal text-neutral-950 md:text-5xl">立委發言目錄</h1>
      <p class="mt-2 text-base text-neutral-600 md:text-lg">
        收錄立法院公報中所有參與委員會詢答的委員，可點擊查看其個人的發言時間軸與核心關切議題。
      </p>
    </div>
  </section>

  <div class="mx-auto w-11/12 space-y-12 md:w-4/5">
    <!-- 1. 高頻率發言委員 (精華展示) -->
    {
      groups["高頻率發言委員"].length > 0 ? (
        <section>
          <h2 class="mb-6 flex items-center gap-2 text-xl font-semibold text-neutral-900">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-amber-500" />
            熱門關注委員
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {groups["高頻率發言委員"].map((leg) => (
              <a
                href={`/legislators/${encodeURIComponent(leg.name.split(" ")[0])}`}
                class="group block rounded-3xl border-2 border-neutral-200 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-amber-500 hover:shadow-lg"
              >
                <h3 class="text-xl font-semibold text-neutral-950 transition-colors group-hover:text-amber-600">
                  {leg.name}
                </h3>
                <p class="mt-2 text-sm text-neutral-500">
                  累計發言頻次：<span class="font-semibold text-neutral-800">{leg.speechCount} 次</span>
                </p>
                <div class="mt-4 border-t border-neutral-100 pt-4">
                  <p class="text-xs text-neutral-400">最新發言會議</p>
                  <p class="mt-1 truncate text-sm font-medium text-neutral-700">{leg.lastAgendaTitle}</p>
                  <p class="mt-1 text-xs text-neutral-400">{leg.lastSpeechDate}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      ) : null
    }

    <!-- 2. 所有活躍委員 (列表與快速檢索) -->
    <section class="border-t border-neutral-200 pt-6">
      <h2 class="mb-6 flex items-center gap-2 text-xl font-semibold text-neutral-900">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-neutral-400"></span>
        所有發言委員 ({legislators.length} 人)
      </h2>

      {
        legislators.length > 0 ? (
          <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
            {legislators.map((leg) => (
              <a
                href={`/legislators/${encodeURIComponent(leg.name.split(" ")[0])}`}
                class="flex items-center justify-between rounded-2xl border border-neutral-200 bg-white px-5 py-4 transition hover:border-neutral-400 hover:bg-neutral-50"
              >
                <div>
                  <span class="font-medium text-neutral-900">{leg.name}</span>
                  <p class="mt-0.5 text-xs text-neutral-400">最新發言：{leg.lastSpeechDate}</p>
                </div>
                <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs font-semibold text-neutral-600">
                  {leg.speechCount} 次
                </span>
              </a>
            ))}
          </div>
        ) : (
          <p class="py-8 text-neutral-500">目前暫無立委發言統計資料，請先透過控制台同步並分析公報。</p>
        )
      }
    </section>
  </div>
</BaseLayout>
