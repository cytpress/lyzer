---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "lyzer", description = "lyzer 將立法院委員會紀錄整理成可搜尋、可收藏、可快速理解的摘要。" } =
  Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased">
    <header class="sticky top-0 z-40 border-b border-neutral-300 bg-white/95 backdrop-blur-sm">
      <div class="page-shell flex h-[4.5rem] items-center justify-between gap-4">
        <a class="shrink-0 px-1" href="/" aria-label="lyzer 首頁">
          <img class="hidden h-9 w-auto md:block" src="/brand/lyzer.svg" alt="LYZER 立院公報摘要" />
          <img class="h-9 w-auto md:hidden" src="/brand/lyzer-no-text.svg" alt="LYZER" />
        </a>

        <form class="hidden min-w-0 flex-1 justify-center md:flex" data-header-search-form>
          <label class="relative w-28 transition-[width] duration-300 focus-within:w-full focus-within:max-w-sm">
            <span class="sr-only">搜尋公報摘要</span>
            <input
              class="h-10 w-full rounded-2xl border-2 border-neutral-300 bg-white pr-10 pl-3 text-sm outline-none placeholder:text-neutral-400 focus:border-neutral-500"
              name="q"
              type="search"
              data-header-search-input
              placeholder="搜尋…"
            />
            <svg
              class="pointer-events-none absolute top-1/2 right-3 h-5 w-5 -translate-y-1/2 text-neutral-400"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
            </svg>
          </label>
        </form>

        <nav class="flex shrink-0 items-center text-sm font-medium text-neutral-700" aria-label="主選單">
          <a
            class="hidden rounded-lg px-3 py-2 hover:bg-neutral-100 hover:text-neutral-950 lg:inline-flex"
            href="/legislators">立委名冊</a
          >
          <a class="rounded-lg px-3 py-2 hover:bg-neutral-100 hover:text-neutral-950" href="/bookmarks">我的收藏</a>
          <a class="rounded-lg px-3 py-2 hover:bg-neutral-100 hover:text-neutral-950" href="/about">關於本站</a>
        </nav>
      </div>
    </header>

    <main class="min-h-[calc(100vh-20rem)] py-8 md:py-12"><slot /></main>

    <footer class="border-t border-neutral-300 bg-white">
      <div
        class="page-shell-narrow flex flex-col items-center gap-5 py-8 text-center text-sm leading-7 text-neutral-600"
      >
        <div>
          <p>本站摘要由 AI 生成，旨在協助快速理解立法院委員會的討論要點。</p>
          <p>內容可能有錯誤或遺漏，引用前請回到詳細頁中的官方公報核對。</p>
        </div>
        <p>
          資料來源：<a
            class="underline underline-offset-4 hover:text-neutral-950"
            href="https://ly.govapi.tw/v2/"
            target="_blank"
            rel="noreferrer">OpenFun Ltd. LYAPI</a
          >
          （<a
            class="underline underline-offset-4 hover:text-neutral-950"
            href="https://creativecommons.org/licenses/by/4.0/deed.zh-hant"
            target="_blank"
            rel="noreferrer">CC BY 4.0</a
          >） ・ <a
            class="underline underline-offset-4 hover:text-neutral-950"
            href="https://github.com/cytpress/lyzer"
            target="_blank"
            rel="noreferrer">GitHub 原始碼</a
          >
        </p>
        <p class="border-t border-neutral-200 px-6 pt-5 text-xs text-neutral-500">
          © {new Date().getFullYear()} cytpress
        </p>
      </div>
    </footer>

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
