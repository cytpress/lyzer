---
// 提供全站共用標頭、頁尾、SEO metadata 與互動入口
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "lyzer",
  description = "LYZER 整理立法院公報與黨團協商紀錄，提供可搜尋、易讀的摘要與官方原文連結。",
  noindex = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen antialiased">
    <header class="sticky top-0 z-40 border-b border-neutral-300 bg-white/95 backdrop-blur-sm">
      <div class="page-shell flex h-[4.5rem] items-center justify-between gap-4">
        <a class="shrink-0 px-1" href="/" aria-label="lyzer 首頁">
          <img class="hidden h-9 w-auto md:block" src="/brand/lyzer.svg" alt="LYZER 立院公報摘要" />
          <img class="h-9 w-auto md:hidden" src="/brand/lyzer-no-text.svg" alt="LYZER" />
        </a>

        <form class="hidden md:block" data-header-search-form>
          <label class="relative block w-24 transition-[width] duration-300 ease-in-out focus-within:w-60">
            <span class="sr-only">搜尋公報摘要</span>
            <input
              class="h-10 w-full rounded-2xl border-2 border-neutral-300 bg-white pr-10 pl-3 text-sm outline-none placeholder:text-neutral-400 focus:border-neutral-500"
              name="q"
              type="search"
              data-header-search-input
              placeholder="搜尋…"
            />
            <svg
              class="pointer-events-none absolute top-1/2 right-3 h-5 w-5 -translate-y-1/2 text-neutral-400"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
            </svg>
          </label>
        </form>

        <nav class="flex shrink-0 items-center text-sm font-medium text-neutral-700" aria-label="主選單">
          <a class="rounded-lg px-3 py-2 hover:bg-neutral-100 hover:text-neutral-950" href="/about">關於本站</a>
        </nav>
      </div>
    </header>

    <main class="min-h-[calc(100vh-20rem)] py-8 md:py-12"><slot /></main>

    <footer class="border-t border-neutral-300 bg-white">
      <div class="page-shell flex flex-col items-center gap-6 py-8 text-center text-sm leading-7 text-neutral-600">
        <div class="w-full space-y-2">
          <p>本站所有摘要內容均由大型語言模型（AI）生成，旨在幫助民眾快速理解立法院委員會的討論要點。</p>
          <p>生成內容可能存在錯誤或不完整之處，使用者應以每頁詳情中「原始數據」連結，參考立法院官方公報為準。</p>
        </div>
        <div class="flex flex-col items-center gap-y-4 md:flex-row md:gap-x-8">
          <p>
            資料來源：
            <a
              class="underline hover:text-neutral-950"
              href="https://ly.govapi.tw/v2/"
              target="_blank"
              rel="noreferrer"
            >
              OpenFun Ltd. LYAPI
            </a>
            （資料依
            <a
              class="underline hover:text-neutral-950"
              href="https://creativecommons.org/licenses/by/4.0/deed.zh-hant"
              target="_blank"
              rel="noreferrer"
            >
              CC BY 4.0
            </a>
            授權）
          </p>
          <a
            class="underline hover:text-neutral-950"
            href="https://github.com/cytpress/lyzer"
            target="_blank"
            rel="noreferrer"
          >
            GitHub 專案原始碼
          </a>
        </div>
        <div class="w-full border-t border-neutral-200 pt-6">
          <p class="text-xs text-neutral-500">
            © {new Date().getFullYear()} cytpress 本站所有內容與原始碼均採用
            <a
              class="underline hover:text-neutral-950"
              href="https://github.com/cytpress/lyzer/blob/v2/LICENSE"
              target="_blank"
              rel="noreferrer"
            >
              MIT 授權
            </a>
          </p>
        </div>
      </div>
    </footer>

    <script>
      import "@/scripts/site.ts";
    </script>
  </body>
</html>
