{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://lyzer.tw/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://lyzer.tw/",
      "permanent": true
    }
  ],
  "installCommand": "true",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
