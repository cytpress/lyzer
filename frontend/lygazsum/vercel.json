{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://lyzer.tw/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://lyzer.tw/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
