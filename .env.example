# API / Postgres
DATABASE_URL=postgresql://lyzer:lyzer@localhost:5432/lyzer
PORT=3000

# LYAPI
LYAPI_BASE_URL=https://ly.govapi.tw/v2
LYAPI_GAZETTE_LIMIT=20
LYAPI_AGENDA_LIMIT=100

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3-flash-preview
ANALYZE_BATCH_SIZE=3

# Astro build reads private Hono SSG endpoints
SSG_API_BASE=http://127.0.0.1:3000

# Cloudflare Deploy Hook URL for remote rebuilds
CLOUDFLARE_DEPLOY_HOOK_URL=
