# Lyzer Scheduler Environment Variables
# ----------------------------------------------------
# This configuration is loaded by the systemd service timers.

# The base URL of the local Hono API server
API_BASE=http://127.0.0.1:3020

# Number of pages to pull during the daily fetch job
FETCH_PAGES=3

# Number of pending agendas to analyze during each 5-minute cron execution
ANALYZE_LIMIT=1
