[Unit]
Description=Lyzer deploy check and trigger Cloudflare hook if needed
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env.scheduler
ExecStart=__APP_DIR__/scripts/lyzer-deploy-check.sh
TimeoutStartSec=10m
